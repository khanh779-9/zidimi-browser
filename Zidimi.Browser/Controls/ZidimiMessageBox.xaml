<Window x:Class="Zidimi.Browser.Controls.ZidimiMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Zidimi.Browser.Controls"
        Title="Zidimi Browser"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="520"
        Background="Transparent"
        Foreground="{DynamicResource Ink100Brush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ZidimiButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="20"
            Background="{DynamicResource ZidimiBgElevatedBrush}"
            BorderBrush="{DynamicResource StrokeLightBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0"
                    Background="{DynamicResource ZidimiBgSurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Height="44"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <TextBlock x:Name="TitleText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink100Brush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            
            <Grid Grid.Row="1" Margin="24,18,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path x:Name="BodyIcon"
                      Grid.Column="0"
                      Width="28" Height="28"
                      Stretch="Uniform"
                      Stroke="{DynamicResource ZidimiPurpleLightBrush}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      VerticalAlignment="Top"
                      Margin="0,2,16,0"
                      Data="M12 2 a10 10 0 1 0 0.01 0 Z M12 8 V12 M12 16 H12.01" />
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           FontSize="14"
                           Foreground="{DynamicResource Ink200Brush}"
                           TextWrapping="Wrap"
                           LineHeight="20" />
            </Grid>

            
            <Border Grid.Row="2"
                    Background="{DynamicResource ZidimiBgSurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="18,14">
                <StackPanel x:Name="ButtonBar"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" />
            </Border>
        </Grid>
    </Border>
</Window>
