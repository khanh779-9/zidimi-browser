<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme: neutral surfaces + Zidimi purple accent. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="ZidimiBgDarkestBrush" Color="#FAFAFB" />
    <SolidColorBrush x:Key="ZidimiBgDarkBrush" Color="#F1F1F4" />
    <SolidColorBrush x:Key="ZidimiBgSurfaceBrush" Color="#F6F6F8" />
    <SolidColorBrush x:Key="ZidimiBgElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ZidimiBgHoverBrush" Color="#ECECF1" />
    <SolidColorBrush x:Key="ZidimiBgActiveBrush" Color="#E7E2FF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F2F2F6" />
    <SolidColorBrush x:Key="Surface0Brush" Color="#FFFFFF" />

    <!-- Browser chrome / structure -->
    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniboxFocusBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabBarBgBrush" Color="#E7E7EC" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F1F4" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F4F4F7" />
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#E7E7EC" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F4F4F7" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="#F2FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ink100Brush" Color="#181727" />
    <SolidColorBrush x:Key="Ink200Brush" Color="#3A3855" />
    <SolidColorBrush x:Key="Ink300Brush" Color="#5C5982" />
    <SolidColorBrush x:Key="Ink400Brush" Color="#8582AC" />
    <SolidColorBrush x:Key="Ink500Brush" Color="#B0AEC8" />

    <!-- Borders / scrollbar -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#DEDEE5" />
    <SolidColorBrush x:Key="StrokeLightBrush" Color="#C8C7D2" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C8C7D2" />

    <!-- Accent. Legacy ZidimiPurple* keys are retained for compatibility. -->
    <SolidColorBrush x:Key="ZidimiPurpleBrush" Color="#6D4AFF" />
    <SolidColorBrush x:Key="ZidimiPurpleLightBrush" Color="#8B6FFF" />
    <SolidColorBrush x:Key="ZidimiPurpleDarkBrush" Color="#4A32B0" />
    <SolidColorBrush x:Key="ZidimiPurpleHoverBrush" Color="#7C5CFF" />
    <SolidColorBrush x:Key="ZidimiPurplePressedBrush" Color="#5A3DE0" />
    <SolidColorBrush x:Key="ZidimiPurpleGlowBrush" Color="#336D4AFF" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#596D4AFF" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#596D4AFF" />

    <LinearGradientBrush x:Key="CtaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#8B6FFF" />
        <GradientStop Offset="1" Color="#6D4AFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtaHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#9B82FF" />
        <GradientStop Offset="1" Color="#7C5CFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtaActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#7C60E6" />
        <GradientStop Offset="1" Color="#5A3DE0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#266D4AFF" />
        <GradientStop Offset="1" Color="#0F8B6FFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandBadgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#8B6FFF" />
        <GradientStop Offset="1" Color="#4A32B0" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="BannerHaloBrush" GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.8" RadiusY="1.2">
        <GradientStop Offset="0.0" Color="#286D4AFF" />
        <GradientStop Offset="0.6" Color="#006D4AFF" />
    </RadialGradientBrush>

    <!-- Danger surfaces are intentionally subtle, not a second primary button color. -->
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FDEDEF" />
    <SolidColorBrush x:Key="DangerHoverBgBrush" Color="#F9DCE1" />
    <SolidColorBrush x:Key="DangerActiveBgBrush" Color="#F4C8CF" />

    <!-- Overlays / effects -->
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#66181727" />
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="AccentShadowColor">#6D4AFF</Color>

</ResourceDictionary>
