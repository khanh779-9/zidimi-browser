<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme-independent design tokens only.
        Theme-sensitive surfaces, text, accent, hover/pressed and shadow colors live in
        LightTheme.xaml / DarkTheme.xaml so switching theme updates
        every control through DynamicResource.
    -->

    <!-- Content rendered on top of an accent/status fill. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Semantic status colors keep their meaning across themes. -->
    <SolidColorBrush x:Key="SafeBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />

    <!-- Shared sizing tokens. -->
    <CornerRadius x:Key="CornerRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMd">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLg">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXl">12</CornerRadius>

</ResourceDictionary>
