<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Classic Theme Palette - Modern Clean Light -->
    <!-- Nền & Card -->
    <SolidColorBrush x:Key="ZidimiBgDarkestBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ZidimiBgDarkBrush" Color="#EAECEF" />
    <SolidColorBrush x:Key="ZidimiBgSurfaceBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="ZidimiBgElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ZidimiBgHoverBrush" Color="#EAECEF" />

    <!-- Component Backgrounds -->
    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OmniboxFocusBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#E02020" />
    <SolidColorBrush x:Key="TabBarBgBrush" Color="#F4F5F7" />

    <!-- Navigation & Structure -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="#CCF4F5F7" />

    <!-- Primary Accent & Secondary Accent (Vibrant Red) -->
    <SolidColorBrush x:Key="ZidimiPurpleBrush" Color="#E02020" />
    <SolidColorBrush x:Key="ZidimiPurpleLightBrush" Color="#FF4D4D" />
    <SolidColorBrush x:Key="ZidimiPurpleDarkBrush" Color="#C01A1A" />
    <SolidColorBrush x:Key="ZidimiPurpleHoverBrush" Color="#FF3333" />
    <SolidColorBrush x:Key="ZidimiPurplePressedBrush" Color="#A01515" />
    <SolidColorBrush x:Key="ZidimiPurpleGlowBrush" Color="#33E02020" />
    <SolidColorBrush x:Key="ZidimiBgActiveBrush" Color="#FFF0F0" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#33E02020" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="CtaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF4D4D" />
        <GradientStop Offset="1" Color="#E02020" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtaHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF6666" />
        <GradientStop Offset="1" Color="#FF3333" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtaActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#E63939" />
        <GradientStop Offset="1" Color="#C01A1A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#1AE02020" />
        <GradientStop Offset="1" Color="#05E02020" />
    </LinearGradientBrush>

    <!-- Typography / Text Colors -->
    <SolidColorBrush x:Key="Ink100Brush" Color="#121212" />
    <SolidColorBrush x:Key="Ink200Brush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="Ink300Brush" Color="#595959" />
    <SolidColorBrush x:Key="Ink400Brush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="Ink500Brush" Color="#BFBFBF" />

    <!-- Borders & Scrollbars (Soft gray borders) -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="StrokeLightBrush" Color="#F3F4F6" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#D1D5DB" />

    <!-- Modal Backdrop -->
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#4D121212" />

</ResourceDictionary>
