<Window x:Class="Zidimi.Browser.Views.DataManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zidimi.Browser.Infrastructure"
        xmlns:controls="clr-namespace:Zidimi.Browser.Controls"
        Title="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[DataMgr_ManageData]}" Height="500" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ZidimiBgSurfaceBrush}"
        Foreground="{DynamicResource Ink100Brush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml" />
                <ResourceDictionary Source="../Controls/ZidimiButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <DataTemplate x:Key="PasswordTemplate">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="{DynamicResource ZidimiBgElevatedBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Url}" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="{Binding Username}" Foreground="{DynamicResource Ink400Brush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Password}" Foreground="{DynamicResource Ink400Brush}" />
                        </StackPanel>
                        <controls:ZidimiButton Grid.Column="1" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[History_Delete]}" Padding="12,6" Tag="{Binding Id}" Click="Delete_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CardTemplate">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="{DynamicResource ZidimiBgElevatedBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="{Binding CardNumber}" Foreground="{DynamicResource Ink400Brush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Expiry}" Foreground="{DynamicResource Ink400Brush}" />
                        </StackPanel>
                        <controls:ZidimiButton Grid.Column="1" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[History_Delete]}" Padding="12,6" Tag="{Binding Guid}" Click="Delete_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AddressTemplate">
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="{DynamicResource ZidimiBgElevatedBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="{Binding Phone}" Foreground="{DynamicResource Ink400Brush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Address}" Foreground="{DynamicResource Ink400Brush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:ZidimiButton Grid.Column="1" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[History_Delete]}" Padding="12,6" Tag="{Binding Guid}" Click="Delete_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblTitle" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Data_Title]}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Background="{DynamicResource ZidimiBgElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel x:Name="PanelAdd">
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Data_Add]}" FontWeight="Bold" Margin="0,0,0,12" />
                
                <Grid x:Name="GridAddInputs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="TxtF1" Grid.Column="0" Margin="0,0,8,0" Height="32" Padding="6" Background="Transparent" Foreground="{DynamicResource Ink100Brush}" BorderBrush="{DynamicResource StrokeBrush}" />
                    <TextBox x:Name="TxtF2" Grid.Column="1" Margin="0,0,8,0" Height="32" Padding="6" Background="Transparent" Foreground="{DynamicResource Ink100Brush}" BorderBrush="{DynamicResource StrokeBrush}" />
                    <TextBox x:Name="TxtF3" Grid.Column="2" Height="32" Padding="6" Background="Transparent" Foreground="{DynamicResource Ink100Brush}" BorderBrush="{DynamicResource StrokeBrush}" />
                </Grid>
                
                <controls:ZidimiButton Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[DataMgr_Save]}" Style="{StaticResource ZidimiButtonPrimary}" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Add_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListItems" />
        </ScrollViewer>

        <controls:ZidimiButton Grid.Row="3" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_Close]}" Width="100" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click" />
    </Grid>
</Window>
