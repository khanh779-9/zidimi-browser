<UserControl x:Class="Zidimi.Browser.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zidimi.Browser.Infrastructure"
             xmlns:models="clr-namespace:Zidimi.Browser.Models"
             xmlns:ctrl="clr-namespace:Zidimi.Browser.Controls"
             Background="{DynamicResource ContentBackgroundBrush}">
    <UserControl.Resources>
        <ctrl:NullToVisibilityConverter x:Key="Null2Vis" />
    </UserControl.Resources>
    <Grid Margin="32,24,32,24" MinWidth="650" MaxWidth="850" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title & Subtitle -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_Title]}"
                           Style="{DynamicResource HeaderText}" Foreground="{DynamicResource Ink100Brush}" />
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_SubTitle]}"
                           Style="{DynamicResource SubHeaderText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ctrl:ZidimiButton x:Name="InstallWebStoreBtn"
                                   Variant="Primary"
                                   Height="36" Padding="14,0" Margin="0,0,8,0"
                                   Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_InstallFromWebStore]}"
                                   IconData="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"
                                   Click="InstallWebStoreBtn_Click" />

                <ctrl:ZidimiButton x:Name="LoadUnpackedBtn"
                                   Variant="Secondary"
                                   Height="36" Padding="14,0" Margin="0,0,8,0"
                                   Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_LoadUnpacked]}"
                                   IconData="M19 11h-6V5a1 1 0 0 0-2 0v6H5a1 1 0 0 0 0 2h6v6a1 1 0 0 0 2 0v-6h6a1 1 0 0 0 0-2z"
                                   Click="LoadUnpackedBtn_Click" />

                <ctrl:ZidimiButton x:Name="OpenWebStoreBtn"
                                   Variant="Ghost"
                                   Height="36" Padding="12,0"
                                   Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_OpenWebStore]}"
                                   IconData="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                   Click="OpenWebStoreBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="{DynamicResource ZidimiBgSurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="19" Height="38" Margin="0,18,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Margin="14,0,0,0"
                      Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="{DynamicResource Ink400Brush}" StrokeThickness="1.5"
                      Data="M15.5,14 h-.79 l-.28,-.27 a6.5,6.5 0 1 0 -.7,.7 l.27,.28 v.79 l5,4.99 L20.49,19 z" />
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         Margin="6,0,12,0"
                         Background="Transparent" BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Ink100Brush}"
                         CaretBrush="{DynamicResource ZidimiPurpleLightBrush}"
                         TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <!-- Empty State -->
        <Border Grid.Row="3" x:Name="EmptyState"
                Background="{DynamicResource ZidimiBgSurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="16" Padding="40" Margin="0,20,0,0"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{DynamicResource ZidimiBgElevatedBrush}" Margin="0,0,0,16">
                    <Path Width="30" Height="30" Stretch="Uniform"
                          Stroke="{DynamicResource ZidimiPurpleLightBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M19 11a2.5 2.5 0 0 0-2.5-2.5h-1.5V7a2.5 2.5 0 0 0-5 0v1.5H8.5A2.5 2.5 0 0 0 6 11v1.5H4.5a2.5 2.5 0 0 0 0 5H6v1.5A2.5 2.5 0 0 0 8.5 21.5h1.5v-1.5a2.5 2.5 0 0 1 5 0v1.5h1.5a2.5 2.5 0 0 0 2.5-2.5v-1.5h1.5a2.5 2.5 0 0 0 0-5H19V11z"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_NoExtensions]}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink200Brush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_NoExtensionsDesc]}"
                           FontSize="13"
                           Foreground="{DynamicResource Ink400Brush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Extensions List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ExtensionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ExtensionInfo}">
                        <Border Background="{DynamicResource ZidimiBgSurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                        Background="{DynamicResource ZidimiBgElevatedBrush}" Margin="0,0,16,0"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <Path x:Name="FallbackIcon" Width="22" Height="22" Stretch="Uniform"
                                              Stroke="{DynamicResource ZidimiPurpleLightBrush}" StrokeThickness="1.5"
                                              Data="M19 11a2.5 2.5 0 0 0-2.5-2.5h-1.5V7a2.5 2.5 0 0 0-5 0v1.5H8.5A2.5 2.5 0 0 0 6 11v1.5H4.5a2.5 2.5 0 0 0 0 5H6v1.5A2.5 2.5 0 0 0 8.5 21.5h1.5v-1.5a2.5 2.5 0 0 1 5 0v1.5h1.5a2.5 2.5 0 0 0 2.5-2.5v-1.5h1.5a2.5 2.5 0 0 0 0-5H19V11z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding IconPath}" Width="36" Height="36" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink100Brush}" />
                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="12"
                                                   Foreground="{DynamicResource Ink400Brush}" Margin="8,2,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="13"
                                               Foreground="{DynamicResource Ink300Brush}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Description, Converter={StaticResource Null2Vis}}" />
                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                               Foreground="{DynamicResource Ink400Brush}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pin / Unpin -->
                                    <ctrl:ZidimiButton Height="32" Width="32"
                                                       Padding="0" CornerRadius="6"
                                                       Tag="{Binding}" Click="Pin_Click"
                                                       Margin="0,0,8,0">
                                        <ctrl:ZidimiButton.Style>
                                            <Style TargetType="{x:Type ctrl:ZidimiButton}"
                                                   BasedOn="{StaticResource {x:Type ctrl:ZidimiButton}}">
                                                <Setter Property="ToolTip" Value="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_Pin]}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_Unpin]}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ctrl:ZidimiButton.Style>
                                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M8 2 H16 L15 7 L19 11 V13 H13 V21 L12 23 L11 21 V13 H5 V11 L9 7 Z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{DynamicResource Ink300Brush}" />
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource ZidimiPurpleLightBrush}" />
                                                            <Setter Property="Fill" Value="{DynamicResource ZidimiPurpleLightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </ctrl:ZidimiButton>

                                    <!-- Toggle Enable/Disable -->
                                    <ctrl:ZidimiCheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                         Tag="{Binding}"
                                                         Click="Toggle_Click"
                                                         Margin="0,0,12,0"
                                                         ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_ToggleTooltip]}" />

                                    <!-- Remove Button -->
                                    <ctrl:ZidimiButton Variant="Danger" Height="32" Width="32"
                                                       Padding="0" CornerRadius="6"
                                                       IconData="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                                       Tag="{Binding}" Click="Remove_Click"
                                                       ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Ext_Remove]}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
