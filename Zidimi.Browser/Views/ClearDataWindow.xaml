<Window x:Class="Zidimi.Browser.Views.ClearDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zidimi.Browser.Infrastructure"
        xmlns:controls="clr-namespace:Zidimi.Browser.Controls"
        Title="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_ClearBrowsingData]}" Height="360" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ZidimiBgSurfaceBrush}"
        Foreground="{DynamicResource Ink100Brush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml" />
                <ResourceDictionary Source="../Controls/ZidimiButton.xaml" />
                <ResourceDictionary Source="../Controls/ZidimiCheckBox.xaml" />
                <ResourceDictionary Source="../Controls/ZidimiComboBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_Title]}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_TimeRange]}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <controls:ZidimiComboBox x:Name="TimeRangeCombo" Width="150" SelectedIndex="3">
                <controls:ZidimiComboBoxItem Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_1Hour]}" />
                <controls:ZidimiComboBoxItem Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_24Hours]}" />
                <controls:ZidimiComboBoxItem Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_7Days]}" />
                <controls:ZidimiComboBoxItem Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_AllTime]}" />
            </controls:ZidimiComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <controls:ZidimiCheckBox x:Name="ChkHistory" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_BrowsingHistory]}" IsChecked="True" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_HistoryDesc]}" Foreground="{DynamicResource Ink400Brush}" Margin="24,0,0,12" FontSize="12" />
            
            <controls:ZidimiCheckBox x:Name="ChkCookies" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_CookiesData]}" IsChecked="True" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_CookiesDesc]}" Foreground="{DynamicResource Ink400Brush}" Margin="24,0,0,12" FontSize="12" />
            
            <controls:ZidimiCheckBox x:Name="ChkCache" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_CachedImages]}" IsChecked="True" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_CacheDesc]}" Foreground="{DynamicResource Ink400Brush}" Margin="24,0,0,12" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <controls:ZidimiButton Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_Cancel]}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <controls:ZidimiButton x:Name="BtnClear" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Clear_ClearData]}" Width="100" Style="{StaticResource ZidimiButtonPrimary}" Click="Clear_Click" />
        </StackPanel>
    </Grid>
</Window>
