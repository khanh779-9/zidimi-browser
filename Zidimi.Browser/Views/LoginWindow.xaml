<Window x:Class="Zidimi.Browser.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zidimi.Browser.Infrastructure"
        xmlns:controls="clr-namespace:Zidimi.Browser.Controls"
        Title="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_SignInZidimi]}" Height="380" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ZidimiBgSurfaceBrush}"
        Foreground="{DynamicResource Ink100Brush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml" />
                <ResourceDictionary Source="../Controls/ZidimiButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_Title]}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_Desc]}" Foreground="{DynamicResource Ink400Brush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

        <TextBlock Grid.Row="2" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_Email]}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtEmail" Grid.Row="3" Height="36" Margin="0,0,0,16" Padding="8" VerticalContentAlignment="Center"
                 Background="{DynamicResource ZidimiBgElevatedBrush}" Foreground="{DynamicResource Ink100Brush}"
                 BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" />

        <TextBlock Grid.Row="4" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_Password]}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtPassword" Grid.Row="5" Height="36" Margin="0,0,0,24" Padding="8" VerticalContentAlignment="Center"
                     Background="{DynamicResource ZidimiBgElevatedBrush}" Foreground="{DynamicResource Ink100Brush}"
                     BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" />

        <TextBlock x:Name="LblError" Grid.Row="6" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <controls:ZidimiButton Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_Close]}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <controls:ZidimiButton x:Name="BtnLogin" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Login_SignIn]}" Width="100" Style="{StaticResource ZidimiButtonPrimary}" Click="Login_Click" />
        </StackPanel>
    </Grid>
</Window>
