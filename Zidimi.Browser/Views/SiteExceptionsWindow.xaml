<Window x:Class="Zidimi.Browser.Views.SiteExceptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Zidimi.Browser.Controls"
        xmlns:infra="clr-namespace:Zidimi.Browser.Infrastructure"
        Title="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Exceptions]}" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface0Brush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Exceptions]}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink100Brush}" Margin="0,0,0,16"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ExceptionsPanel" />
        </ScrollViewer>
        
        <ctrl:ZidimiButton Grid.Row="2" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Cookie_Close]}" Style="{DynamicResource ZidimiButtonPrimary}" Width="100" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click"/>
    </Grid>
</Window>
