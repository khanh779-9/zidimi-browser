<UserControl x:Class="Zidimi.Browser.Views.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zidimi.Browser.Infrastructure"
             xmlns:models="clr-namespace:Zidimi.Browser.Models"
             xmlns:ctrl="clr-namespace:Zidimi.Browser.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <ctrl:BoolToVisibilityConverter x:Key="Bool2Vis" />
        <ctrl:NullToVisibilityConverter x:Key="Null2Vis" />
        <Style x:Key="TabAudioButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioPlaying}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="TabBarGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        
        <Button x:Name="ScrollLeftBtn"
                Grid.Column="0"
                Width="30" Height="34"
                Margin="2,3,0,3"
                Style="{DynamicResource ToolIconButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Visibility="Collapsed"
                Click="ScrollLeft_Click"
                ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Tab_ScrollLeft]}">
            <Path Width="12" Height="12" Stretch="Uniform"
                  Stroke="{DynamicResource Ink200Brush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M13,6 L8,12 L13,18" />
        </Button>

        
        <ScrollViewer x:Name="TabScroller"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Hidden"
                      PanningMode="HorizontalOnly"
                      PreviewMouseWheel="TabScroller_PreviewMouseWheel"
                      ScrollChanged="TabScroller_ScrollChanged">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TabViewModel}">
                        <Border Margin="1,0,1,0"
                                Padding="14,0,8,0"
                                MinWidth="170" MaxWidth="240"
                                Cursor="Hand"
                                VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                MouseLeftButtonUp="Tab_MouseLeftButtonUp"
                                MouseMove="Tab_MouseMove"
                                MouseRightButtonDown="Tab_MouseRightButtonDown"
                                Drop="Tab_Drop"
                                DragOver="Tab_DragOver">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8,8,0,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ZidimiBgHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TabActiveBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ZidimiPurpleBrush}" />
                                            <Setter Property="BorderThickness" Value="1,1,1,0" />
                                        </DataTrigger>
                                        
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Padding" Value="10,0,10,0" />
                                            <Setter Property="MinWidth" Value="40" />
                                            <Setter Property="MaxWidth" Value="40" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0"
                                      VerticalAlignment="Center">
                                    
                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{DynamicResource ZidimiPurpleLightBrush}" Fill="Transparent"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Settings">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Data" Value="M19.4 15 a1.65 1.65 0 0 0 .33 1.82l.06.06 a2 2 0 0 1-2.83 2.83 l-.06-.06 a1.65 1.65 0 0 0-1.82-.33 a1.65 1.65 0 0 0-1 1.51 V21 a2 2 0 1 1-4 0 v-.09 A1.65 1.65 0 0 0 9 19.4 a1.65 1.65 0 0 0-1.82.33 l-.06.06 a2 2 0 1 1-2.83-2.83 l.06-.06 A1.65 1.65 0 0 0 4.6 15 a1.65 1.65 0 0 0-1.51-1 H3 a2 2 0 1 1 0-4 h.09 A1.65 1.65 0 0 0 4.6 9 a1.65 1.65 0 0 0-.33-1.82 l-.06-.06 a2 2 0 1 1 2.83-2.83 l.06.06 A1.65 1.65 0 0 0 9 4.6 a1.65 1.65 0 0 0 1-1.51 V3 a2 2 0 1 1 4 0 v.09 A1.65 1.65 0 0 0 15 4.6 a1.65 1.65 0 0 0 1.82-.33 l.06-.06 a2 2 0 1 1 2.83 2.83 l-.06.06 A1.65 1.65 0 0 0 19.4 9 V15 z M12 15 a3 3 0 1 1 0-6 a3 3 0 0 1 0 6 z" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="History">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Data" Value="M12 3 a9 9 0 1 0 9 9 M12 7 v5 l3 2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Bookmarks">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Data" Value="M12 2 L15.09 8.26 L22 9.27 L17 14.14 L18.18 21.02 L12 17.77 L5.82 21.02 L7 14.14 L2 9.27 L8.91 8.26 Z" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Downloads">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Data" Value="M12 3 v12 m-5-5 l5 5 l5-5 M5 21 h14" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    
                                    <ctrl:LoadingSpinner Visibility="{Binding IsLoading, Converter={StaticResource Bool2Vis}}" />
                                    
                                    <Image Visibility="{Binding Favicon, Converter={StaticResource Null2Vis}}"
                                           Source="{Binding Favicon}"
                                           Width="16" Height="16" Stretch="Uniform" />
                                    
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Visibility="{Binding Favicon, Converter={StaticResource Null2Vis}, ConverterParameter=invert}"
                                          Data="M2 12 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0 Z"
                                          Stroke="{DynamicResource ZidimiPurpleLightBrush}" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Ink200Brush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ink100Brush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <Button Grid.Column="2" Width="22" Height="22"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource TabAudioButtonStyle}"
                                        Tag="{Binding}"
                                        Click="Audio_Click"
                                        ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Tab_Mute]}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                                                <Grid>
                                                    
                                                    <Path x:Name="speaker" Width="14" Height="14" Stretch="Uniform"
                                                          Stroke="{DynamicResource Ink200Brush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M4,10 H7 L11,6 V18 L7,14 H4 Z M13,9 a3,3 0 0 1 0,6 M15.5,6.5 a6,6 0 0 1 0,11">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    
                                                    <Path x:Name="muted" Width="14" Height="14" Stretch="Uniform"
                                                          Stroke="{DynamicResource Ink200Brush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M4,10 H7 L11,6 V18 L7,14 H4 Z M14,11 L18,15 M18,11 L14,15">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ZidimiBgHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="3" Width="22" Height="22"
                                        Margin="6,0,-4,0"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        Click="CloseTab_Click"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                                                <Path x:Name="iconPath" Width="10" Height="10" Stretch="Uniform"
                                                      Stroke="{DynamicResource Ink300Brush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M2,2 L10,10 M10,2 L2,10"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="iconPath" Property="Stroke" Value="{DynamicResource Ink100Brush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ZidimiPurpleBrush}" />
                                                    <Setter TargetName="iconPath" Property="Stroke" Value="{DynamicResource OnAccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        
        <Button x:Name="ScrollRightBtn"
                Grid.Column="2"
                Width="30" Height="34"
                Margin="0,3,2,3"
                Style="{DynamicResource ToolIconButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Visibility="Collapsed"
                Click="ScrollRight_Click"
                ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Tab_ScrollRight]}">
            <Path Width="12" Height="12" Stretch="Uniform"
                  Stroke="{DynamicResource Ink200Brush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M11,6 L16,12 L11,18" />
        </Button>

        
        <Button Grid.Column="3" Width="34" Height="34"
                Margin="6,3,6,3"
                Style="{DynamicResource ToolIconButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Command="{Binding NewTabCommand}" ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Tab_NewTabShortcut]}">
            <Path Width="14" Height="14" Stretch="Uniform"
                  Stroke="{DynamicResource Ink200Brush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" />
        </Button>

        
        <Button x:Name="TabSearchBtn"
                Grid.Column="4"
                Width="30" Height="34"
                Margin="0,3,2,3"
                Style="{DynamicResource ToolIconButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="TabSearchBtn_Click"
                ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Tab_Search]}">
            <Path Width="13" Height="13" Stretch="Uniform"
                  Stroke="{DynamicResource Ink200Brush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M11,4 a7,7 0 1 0 0 14 a7,7 0 1 0 0 -14 M20,20 L15,15" />
        </Button>

        
        <Button x:Name="AllTabsBtn"
                Grid.Column="5"
                Width="30" Height="34"
                Margin="0,3,6,3"
                Style="{DynamicResource ToolIconButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="AllTabs_Click"
                ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Tab_List]}">
            <Path Width="12" Height="12" Stretch="Uniform"
                  Stroke="{DynamicResource Ink200Brush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M7,5 L12,10 L17,5 M7,12 L12,17 L17,12" />
        </Button>
        </Grid>

    <Popup x:Name="TabSearchPopup"
           PlacementTarget="{Binding ElementName=TabSearchBtn}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border Background="{DynamicResource ZidimiBgElevatedBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8" Width="320"
                MaxHeight="360">
            <StackPanel>
                <TextBox x:Name="TabSearchBox"
                         Margin="0,0,0,8"
                         Padding="8,6"
                         FontSize="13"
                         TextChanged="TabSearchBox_TextChanged"
                         KeyDown="TabSearchBox_KeyDown"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Ink100Brush}"
                         CaretBrush="{DynamicResource ZidimiPurpleLightBrush}" />
                <ListBox x:Name="TabSearchList"
                         BorderThickness="0" Background="Transparent"
                         MaxHeight="400"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="TabSearchList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink200Brush}" />
                            <Setter Property="FontSize" Value="13" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ZidimiPurpleBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
