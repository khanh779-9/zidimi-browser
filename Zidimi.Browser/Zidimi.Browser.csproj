<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
<OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
<Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <InformationalVersion>1.7.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Zidimi.Browser</RootNamespace>
    <AssemblyName>Zidimi.Browser</AssemblyName>
    <!-- Khóa toàn bộ ứng dụng ở nền tảng x86 (32-bit). -->
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Cho phép chạy trên .NET 9 nếu .NET 8 chưa cài -->
    <RollForward>Major</RollForward>
    <CefSharpAnyCpu>false</CefSharpAnyCpu>
    <ApplicationIcon>zidimi-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="zidimi-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="150.0.110" />
    <!-- Chrome-runtime/HWND host: required for real Chromium extension support. -->
    <PackageReference Include="CefSharp.Wpf.HwndHost" Version="150.0.110" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
  </ItemGroup>

  <!-- NotifyIcon (system tray) dùng WinForms nhưng không bật UseWindowsForms global
       để tránh xung đột tên type giữa WPF và WinForms. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <None Update="language\*.lng">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
