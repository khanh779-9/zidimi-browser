<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Heco.Browser.Controls">

    <!-- =====================  WINDOW CAPTION BUTTONS  ===================== -->
    <Style x:Key="WindowButtonBase" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HecoBgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HecoBgActiveBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =====================  HECO WINDOW TEMPLATE (Chrome-style)  ===================== -->
    <Style x:Key="HecoWindowStyle" TargetType="local:HecoWindow">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink100Brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <!-- KHÔNG set WindowStyle=None: giữ frame native để Windows animate minimize/maximize/snap.
             WindowChrome vẫn chiếm caption area để custom title bar + kéo window. -->
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="AllowsTransparency" Value="False" />
        <Setter Property="ShowInTaskbar" Value="True" />
        <Setter Property="MinWidth" Value="960" />
        <Setter Property="MinHeight" Value="640" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HecoWindow">
                    <Border x:Name="PART_WindowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1">
                        <Grid x:Name="PART_RootGrid" Margin="{TemplateBinding MaximizedPadding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Title bar = logo + tab strip slot + caption buttons (Chrome-style) -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource TabBarBackgroundBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Brand logo (ngoài tab strip) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="12,0,4,0"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Border Width="22" Height="22" CornerRadius="6"
                                                Background="{DynamicResource BrandBadgeBrush}">
                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M9,4 L15,12 L9,20 L7.5,18.5 L12,12 L7.5,5.5 z"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{TemplateBinding BrandText}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink100Brush}"
                                                   Margin="8,0,12,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Tab strip slot (inject từ MainWindow) -->
                                    <ContentControl Grid.Column="1" x:Name="PART_TabStripSlot"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />

                                    <!-- Caption buttons -->
                                    <StackPanel Grid.Column="2" x:Name="PART_CaptionButtons"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button x:Name="PART_MinimizeBtn"
                                                Style="{StaticResource WindowButtonBase}"
                                                WindowChrome.IsHitTestVisibleInChrome="True"
                                                ToolTip="Thu nhỏ">
                                            <Path Width="10" Height="10" Stretch="Uniform"
                                                  Stroke="{DynamicResource Ink300Brush}"
                                                  StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M2,5 L8,5" />
                                        </Button>
                                        <Button x:Name="PART_MaximizeBtn"
                                                Style="{StaticResource WindowButtonBase}"
                                                WindowChrome.IsHitTestVisibleInChrome="True"
                                                ToolTip="Phóng to">
                                            <Grid Width="10" Height="10">
                                                <Path x:Name="PART_MaximizePath"
                                                      Stroke="{DynamicResource Ink300Brush}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stretch="Uniform"
                                                      Data="M2,2 L8,2 L8,8 L2,8 Z" />
                                                <Path x:Name="PART_RestorePath"
                                                      Stroke="{DynamicResource Ink300Brush}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stretch="Uniform"
                                                      Data="M5,1 L1,1 L1,6 M3,4 L8,4 L8,9 L3,9 Z"
                                                      Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="PART_CloseBtn"
                                                Style="{StaticResource WindowCloseButton}"
                                                WindowChrome.IsHitTestVisibleInChrome="True"
                                                ToolTip="Đóng">
                                            <Path x:Name="CloseGlyph" Width="10" Height="10" Stretch="Uniform"
                                                  Stroke="{DynamicResource Ink300Brush}"
                                                  StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M2,2 L8,8 M8,2 L2,8" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <Border x:Name="PART_ContentBorder" Grid.Row="1">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Dạng native WindowChrome: ẩn custom buttons, chừa chỗ cho aero buttons của Windows -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="UseNativeCaption" Value="True">
                            <Setter TargetName="PART_CaptionButtons" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TabStripSlot" Property="Margin" Value="0,0,138,0" />
                        </Trigger>
                        <!-- Close button: icon trắng khi hover (nền danger tối) -->
                        <Trigger SourceName="PART_CloseBtn" Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseGlyph" Property="Stroke" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
