<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Heco.Browser.Controls">

    <Geometry x:Key="HecoCloseSmallGeometry">M3,3 L9,9 M9,3 L3,9</Geometry>

    <!-- Converter phải khai báo trong cùng dictionary với template dùng StaticResource. -->
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

    <!-- =====================  HECO TOAST  ===================== -->
    <Style TargetType="{x:Type local:HecoToast}">
        <Setter Property="Foreground" Value="{DynamicResource Ink100Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="320" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HecoToast}">
                    <Border x:Name="Card"
                            Background="#F2222135"
                            BorderBrush="{DynamicResource StrokeLightBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Dot" Grid.Column="0"
                                    Width="8" Height="8"
                                    CornerRadius="4"
                                    Background="{DynamicResource InfoBrush}"
                                    VerticalAlignment="Top"
                                    Margin="2,5,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource Ink100Brush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}" />
                                <TextBlock Text="{TemplateBinding Message}"
                                           Foreground="{DynamicResource Ink200Brush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{TemplateBinding CloseCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="22" Height="22"
                                    Cursor="Hand"
                                    ToolTip="Đóng"
                                    VerticalAlignment="Top">
                                <Path Data="{DynamicResource HecoCloseSmallGeometry}"
                                      Stroke="{DynamicResource Ink400Brush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="10" Height="10" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Success">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource SafeBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Warn">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource WarnBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Danger">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================  HECO TOAST HOST  ===================== -->
    <Style TargetType="{x:Type local:HecoToastHost}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HecoToastHost}">
                    <StackPanel x:Name="PART_Panel" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
