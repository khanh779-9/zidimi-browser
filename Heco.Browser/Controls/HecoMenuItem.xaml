<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Heco.Browser.Controls">

    
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

    
    <Style TargetType="{x:Type local:HecoMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Ink200Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HecoMenuItem}">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="4,1" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Icon"
                                  Data="{TemplateBinding IconData}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="16" Height="16"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Visibility="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}" />
                            <ContentPresenter VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HecoBgHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink100Brush}" />
                        </Trigger>
                        <Trigger Property="IsDanger" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
