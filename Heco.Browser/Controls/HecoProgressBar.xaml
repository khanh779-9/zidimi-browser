<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Heco.Browser.Controls">

    
    <Style TargetType="{x:Type local:HecoProgressBar}">
        <Setter Property="Height" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource HecoPurpleBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HecoProgressBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="PART_Track"
                                Background="Transparent"
                                ClipToBounds="True">
                            <Grid x:Name="PART_Indicator"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="PART_IndicatorTransform" X="0" />
                                </Grid.RenderTransform>
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="1" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_Indicator" Property="Width" Value="120" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateAnim">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_IndicatorTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-120" To="800"
                                                         Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
