<controls:HecoWindow x:Class="Heco.Browser.Views.ProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Heco.Browser.Controls"
        xmlns:infra="clr-namespace:Heco.Browser.Infrastructure"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[ProfileManager_Title]}" 
        Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource HecoBgSurfaceBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[ProfileManager_Title]}" 
                   FontSize="22" FontWeight="SemiBold" 
                   Foreground="{DynamicResource Ink100Brush}" 
                   Margin="0,0,0,16" />

        <ListBox x:Name="ProfileList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="0,0,0,16">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="18" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink100Brush}" />
                            <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[ProfileManager_Active]}" 
                                       FontSize="12" Foreground="{DynamicResource Ink400Brush}" 
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:HecoButton Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[ProfileManager_Switch]}" 
                                                 Style="{DynamicResource HecoButtonSecondary}"
                                                 Margin="0,0,8,0"
                                                 Visibility="{Binding IsNotActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Click="Switch_Click" Tag="{Binding}" />
                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Visibility="{Binding IsNotActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="Delete_Click" Tag="{Binding}" ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[ProfileManager_Delete]}">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="#EF4444"
                                      Data="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <controls:HecoButton Grid.Row="2" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[ProfileManager_Add]}" 
                             Style="{DynamicResource HecoButtonPrimary}" 
                             HorizontalAlignment="Right" Click="Add_Click" Padding="20,10" />
    </Grid>
</controls:HecoWindow>
