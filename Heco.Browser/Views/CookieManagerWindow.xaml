<Window x:Class="Heco.Browser.Views.CookieManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Heco.Browser.Infrastructure"
        xmlns:controls="clr-namespace:Heco.Browser.Controls"
        Title="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Cookie_Title]}"
        Height="460" Width="520" MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource HecoBgSurfaceBrush}"
        Foreground="{DynamicResource Ink100Brush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml" />
                <ResourceDictionary Source="../Controls/HecoButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Cookie_Title]}"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock x:Name="CookieCount" Grid.Row="1"
                   FontSize="12" Foreground="{DynamicResource Ink400Brush}" Margin="0,0,0,10" />

        <ListBox Grid.Row="2" x:Name="CookieList" BorderThickness="0"
                 Background="{DynamicResource HecoBgElevatedBrush}"
                 FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <controls:HecoButton x:Name="BtnDelete" Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Cookie_DeleteSelected]}"
                                 Style="{StaticResource HecoButtonDanger}" Margin="0,0,8,0" Click="Delete_Click" />
            <controls:HecoButton Content="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Cookie_Close]}"
                    Click="Close_Click" Width="80" />
        </StackPanel>
    </Grid>
</Window>