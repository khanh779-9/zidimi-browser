        <PathGeometry x:Key="IconAutofill">M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4</PathGeometry>
        <PathGeometry x:Key="IconDefaultBrowser">M2 4v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z M10 4v4 M2 8h20 M6 4v4</PathGeometry>
        <PathGeometry x:Key="IconAppearance">M18.37 2.63a3 3 0 0 1 4.26 4.26l-9 9a3 3 0 0 1-1.7.83l-4 1a1 1 0 0 1-1.2-1.2l1-4a3 3 0 0 1 .83-1.7z M14 8l2 2 M9 22v-6</PathGeometry>
        <PathGeometry x:Key="IconSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35</PathGeometry>
        <PathGeometry x:Key="IconPrivacy">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10 M9 12l2 2 4-4</PathGeometry>
        <PathGeometry x:Key="IconDownloads">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3</PathGeometry>
        <PathGeometry x:Key="IconLanguages">M5 8l6 6 M4 14l6-6 2-3 M2 5h12 M7 2h1 M22 22l-5-10-5 10 M14 18h6</PathGeometry>
