        <PathGeometry x:Key="IconAbout">M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z M12 16v-4 M12 8h.01</PathGeometry>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" Background="{DynamicResource HecoBgSurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,24">
                    
                    <Border Background="{DynamicResource HecoBgElevatedBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="8" Margin="12,0,12,16" Padding="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="16" Height="16" Margin="8,0,0,0"
                                  Stretch="Uniform" VerticalAlignment="Center"
                                  Stroke="{DynamicResource Ink400Brush}" StrokeThickness="1.5"
                                  Data="M15.5 14 h-.79 l-.28-.27 a6.5 6.5 0 1 0 -.7.7 l.27.28 v.79 l5 4.99 L20.49 19 z" />
                            <TextBox Grid.Column="1" x:Name="SettingsSearchBox"
                                     Margin="8,0,8,0" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource Ink100Brush}"
                                     CaretBrush="{DynamicResource HecoPurpleLightBrush}"
                                     TextChanged="SettingsSearchBox_TextChanged"
                                     ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_SearchPlaceholder]}" />
                        </Grid>
                    </Border>
                    
                    <StackPanel x:Name="NavPanel">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}" />
                            </Style>
                        </StackPanel.Resources>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="General" IsChecked="True" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconGeneral}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_General]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="Profiles" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconProfiles}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Profile]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="Autofill" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconAutofill}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Autofill]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="DefaultBrowser" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconDefaultBrowser}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_DefaultBrowser]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="Privacy" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconPrivacy}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Privacy]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="Appearance" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconAppearance}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Appearance]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="Search" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconSearch}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Search]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="Downloads" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconDownloads}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Downloads_Title]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="Languages" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconLanguages}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_Languages]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="System" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconSystem}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_System]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                        <ctrl:HecoRadioButton Style="{DynamicResource SidebarNavButton}" GroupName="SettingsNav"
                                     Tag="About" Checked="NavItem_Checked">
                            <ctrl:HecoRadioButton.Content>
                                <Grid Margin="4,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:HecoRadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource IconAbout}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_About]}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </ctrl:HecoRadioButton.Content>
                        </ctrl:HecoRadioButton>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}">
            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="90*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="SettingsContent" Grid.Column="1" Margin="0,34,0,32" HorizontalContentAlignment="Stretch" />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

