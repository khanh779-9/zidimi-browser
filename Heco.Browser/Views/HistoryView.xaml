<UserControl x:Class="Heco.Browser.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Heco.Browser.Infrastructure"
             xmlns:models="clr-namespace:Heco.Browser.Models"
             Background="{DynamicResource ContentBackgroundBrush}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="HistorySource" Source="{Binding History}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupDateText" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="32,24,32,24" MinWidth="600" MaxWidth="800" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Menu_History]}" Style="{DynamicResource HeaderText}" Foreground="{DynamicResource Ink100Brush}" />
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[History_Desc]}" Style="{DynamicResource SubHeaderText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource CtaButton}"
                    Click="ClearAll_Click"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M6,19 c0,1.1 .9,2 2,2 h8 c1.1,0 2,-.9 2,-2 V7 H6 z M19,4 H16 l-1,-1 H9 L8,4 H5 V6 H19 z"
                          Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Common_ClearAll]}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        
        <Border Grid.Row="1" Background="{DynamicResource HecoBgSurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="19" Height="38" Margin="0,20,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Margin="14,0,0,0"
                      Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="{DynamicResource Ink400Brush}" StrokeThickness="1.5"
                      Data="M15.5,14 h-.79 l-.28,-.27 a6.5,6.5 0 1 0 -.7,.7 l.27,.28 v.79 l5,4.99 L20.49,19 z" />
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         Margin="6,0,12,0"
                         Background="Transparent" BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Ink100Brush}"
                         CaretBrush="{DynamicResource HecoPurpleLightBrush}"
                         Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[History_Search]}" />
            </Grid>
        </Border>

        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Source={StaticResource HistorySource}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="15" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource Ink100Brush}" 
                                           Margin="0,16,0,8" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:HistoryEntry}">
                        <Border Background="{DynamicResource HecoBgSurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8"
                                MouseLeftButtonDown="Entry_Click" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Width="36" Height="36"
                                        Background="{DynamicResource HecoBgElevatedBrush}"
                                        CornerRadius="8" VerticalAlignment="Center">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{DynamicResource HecoPurpleLightBrush}" StrokeThickness="1.4"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M12,2 a10,10 0 1 0 0,20 a10,10 0 1 0 0,-20 M2,12 h20 M12,2 c3,4 3,18 0,20 c-3,-2 -3,-18 0,-20" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink100Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Url}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Ink400Brush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VisitedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Ink500Brush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                            ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[History_Reopen]}" Cursor="Hand"
                                            Tag="{Binding}" Click="Open_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Stroke="{DynamicResource Ink300Brush}" StrokeThickness="1.5"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M9,18 L15,12 L9,6 L7.5,7.5 L12,12 L7.5,16.5 Z" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HecoBgHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                            ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[History_Delete]}" Cursor="Hand" Margin="4,0,0,0"
                                            Click="Delete_Click" Tag="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Stroke="{DynamicResource Ink400Brush}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M6,19 c0,1.1 .9,2 2,2 h8 c1.1,0 2,-.9 2,-2 V7 H6 z M19,4 H16 l-1,-1 H9 L8,4 H5 V6 H19 z" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
