<UserControl x:Class="Heco.Browser.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Heco.Browser.Infrastructure"
             xmlns:models="clr-namespace:Heco.Browser.Models"
             xmlns:ctrl="clr-namespace:Heco.Browser.Controls"
             Background="{DynamicResource ContentBackgroundBrush}">
    <UserControl.Resources>
        <ctrl:BoolToVisibilityConverter x:Key="Bool2Vis" />
        <CollectionViewSource x:Key="DownloadsSource" Source="{Binding Downloads}" />
    </UserControl.Resources>
    <Grid Margin="32,24,32,24" MinWidth="600" MaxWidth="800" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Downloads_Title]}" Style="{DynamicResource HeaderText}" Foreground="{DynamicResource Ink100Brush}" />
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Downloads_Desc]}" Style="{DynamicResource SubHeaderText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource CtaButton}"
                    Command="{Binding ClearDownloadsCommand}"
                    Padding="14,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M6,19 c0,1.1 .9,2 2,2 h8 c1.1,0 2,-.9 2,-2 V7 H6 z M19,4 H16 l-1,-1 H9 L8,4 H5 V6 H19 z"
                          Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Common_ClearAll]}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- search -->
        <Border Grid.Row="1" Background="{DynamicResource HecoBgSurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="19" Height="38" Margin="0,20,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Margin="14,0,0,0"
                      Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="{DynamicResource Ink400Brush}" StrokeThickness="1.5"
                      Data="M15.5,14 h-.79 l-.28,-.27 a6.5,6.5 0 1 0 -.7,.7 l.27,.28 v.79 l5,4.99 L20.49,19 z" />
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         Margin="6,0,12,0"
                         Background="Transparent" BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Ink100Brush}"
                         CaretBrush="{DynamicResource HecoPurpleLightBrush}"
                         ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Downloads_Search]}" />
            </Grid>
        </Border>

        <!-- empty state -->
        <Border Grid.Row="2" x:Name="EmptyState"
                Background="{DynamicResource HecoBgSurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="12" Padding="32"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28"
                        Background="{DynamicResource HecoBgElevatedBrush}" Margin="0,0,0,12">
                    <Path Width="26" Height="26" Stretch="Uniform"
                          Stroke="{DynamicResource HecoPurpleLightBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M19,9 H5 a2,2 0 0 0 -2,2 v6 a2,2 0 0 0 2,2 h14 a2,2 0 0 0 2,-2 V11 a2,2 0 0 0 -2,-2 z M14,15 L10,11 L6,15"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Downloads_Empty]}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink200Brush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Downloads_EmptyDesc]}"
                           FontSize="12"
                           Foreground="{DynamicResource Ink400Brush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- list -->
        <ScrollViewer Grid.Row="2" x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsControl ItemsSource="{Binding Source={StaticResource DownloadsSource}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DownloadEntry}">
                        <Border Background="{DynamicResource HecoBgSurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8"
                                Cursor="Hand"
                                MouseLeftButtonDown="Entry_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- file icon -->
                                <Border Grid.Column="0" Width="40" Height="40"
                                        Background="{DynamicResource HecoBgElevatedBrush}"
                                        CornerRadius="8" VerticalAlignment="Center">
                                    <Path Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{DynamicResource HecoPurpleLightBrush}" StrokeThickness="1.4"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19,9 H5 a2,2 0 0 0 -2,2 v6 a2,2 0 0 0 2,2 h14 a2,2 0 0 0 2,-2 V11 a2,2 0 0 0 -2,-2 z M14,15 L10,11 L6,15" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SuggestedFileName}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink100Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Url}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Ink400Brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReceivedBytes, StringFormat=' | {0:N0} bytes'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Ink500Brush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding TotalBytes, StringFormat='/{0:N0} bytes'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Ink500Brush}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource HecoPurpleBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComplete}" Value="False">
                                                        <Setter Property="Text" Value="Đang tải..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                            ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Pref_OpenFolder]}" Cursor="Hand"
                                            Tag="{Binding}" Click="OpenFolder_Click"
                                            Visibility="{Binding IsComplete, Converter={StaticResource Bool2Vis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Stroke="{DynamicResource Ink300Brush}" StrokeThickness="1.5"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M10,4 L4,4 a2,2 0 0 0 -2,2 v12 a2,2 0 0 0 2,2 h12 a2,2 0 0 0 2,-2 V8 L10,4 z M4,16 V6 a2,2 0 0 1 2,-2 h12" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HecoBgHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                            ToolTip="{Binding Source={x:Static infra:LanguageManager.Instance}, Path=[Downloads_RemoveFromList]}" Cursor="Hand" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                                    <Path Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{DynamicResource Ink400Brush}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M2,2 L10,10 M10,2 L2,10" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>